# Base URL del backend. Opzionale in dev: se assente, il FE usa
# http://<host-della-pagina>:8080 (funziona sia da PC che da smartphone in LAN).
# Prod: viene passato come build arg Docker (VITE_API_BASE_URL=https://<API_DOMAIN>),
# vedi docker-compose.yml nel repo javaWS. Qui serve solo per build locali di prova.
VITE_API_BASE_URL=http://localhost:8080

# OAuth Client ID di Google (Google Cloud Console → API e servizi → Credenziali).
# Abilita il bottone "Continua con Google" in login/registrazione; se assente
# il bottone non viene mostrato. In prod va passato come build arg Docker.
VITE_GOOGLE_CLIENT_ID=
